@echo off
setlocal EnableExtensions DisableDelayedExpansion

rem Foxhole streams batch content to cmd.exe through stdin.  The current
rem directory is the writable per-run workspace; %~dp0 and %TEMP% are not
rem reliable for this execution mode. Write directly into the existing
rem workspace instead of creating a child directory.
set "EVENT_ROOT=%CD%"
set "EVENT_LOG=%EVENT_ROOT%\simulated_events.log"
set "SAMPLE_FILE=%EVENT_ROOT%\sample_edit_target.txt"

echo [bat simulator] start
>> "%EVENT_LOG%" echo start

echo [bat simulator] network event: attempting http://example.com/
>> "%EVENT_LOG%" echo network_call url=http://example.com/ starting
curl.exe --max-time 10 --silent --show-error --output nul http://example.com/
set "NETWORK_EXIT=%ERRORLEVEL%"
echo [bat simulator] network event complete: exit=%NETWORK_EXIT%
>> "%EVENT_LOG%" echo network_call url=http://example.com/ exit=%NETWORK_EXIT%

echo [bat simulator] file event: writing "%SAMPLE_FILE%"
(
    echo Last edited by hyperv_event_simulator.bat
    echo Marker generated by Foxhole batch test
) > "%SAMPLE_FILE%"
set "FILE_EXIT=%ERRORLEVEL%"
echo [bat simulator] file event complete: exit=%FILE_EXIT%
>> "%EVENT_LOG%" echo file_edit path=%SAMPLE_FILE% exit=%FILE_EXIT%

echo [bat simulator] child event: launching cmd.exe
cmd.exe /d /c "echo child process running"
set "CHILD_EXIT=%ERRORLEVEL%"
echo [bat simulator] child event complete: exit=%CHILD_EXIT%
>> "%EVENT_LOG%" echo process_spawn command=cmd.exe exit=%CHILD_EXIT%

echo [bat simulator] finish
>> "%EVENT_LOG%" echo finish network_exit=%NETWORK_EXIT% file_exit=%FILE_EXIT% child_exit=%CHILD_EXIT%

rem Keep the batch target successful when the intentionally denied network
rem attempt fails; the event and its exit code are still recorded.
exit /b 0
